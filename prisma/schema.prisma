generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String               @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  plan                 String               @default("free")
  bachsCustomerId      String?
  bachsSubscriptionId  String?
  notifyEmail          Boolean              @default(true)
  notifyIncidents      Boolean              @default(true)
  notifyWeeklyReport   Boolean              @default(false)
  slackWebhookUrl      String?
  slackChannelName     String?
  slackTeamName        String?
  pagerdutyKey         String?
  customIntervalSec    Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  accounts             Account[]
  sessions             Session[]
  projects             Project[]
  passwordResetTokens  PasswordResetToken[]
  teamMembers          TeamMember[]         @relation("TeamOwner")
  supportCalls         SupportCall[]
}

model Project {
  id         String      @id @default(cuid())
  userId     String
  name       String
  url        String
  type       String      @default("manual")
  provider   String?
  externalId String?
  metadata   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidents  Incident[]
  uptimeLogs UptimeLog[]
  statusPage StatusPage?
}

model Incident {
  id         String   @id @default(cuid())
  projectId  String
  startedAt  DateTime @default(now())
  resolvedAt DateTime?
  duration   Int?     // seconds
  cause      String?
  error      String?
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model UptimeLog {
  id         String   @id @default(cuid())
  projectId  String
  ok         Boolean
  responseMs Int?
  statusCode Int?
  region     String   @default("eu-west")
  checkedAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StatusPage {
  id        String   @id @default(cuid())
  projectId String   @unique
  slug      String   @unique
  title     String
  public    Boolean  @default(true)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id        String   @id @default(cuid())
  ownerId   String
  email     String
  name      String?
  role      String   @default("member")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, email])
}

model SupportCall {
  id          String   @id @default(cuid())
  userId      String
  name        String
  email       String
  topic       String
  description String?
  preferredAt DateTime
  timezone    String   @default("UTC")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String?
  name        String?
  email       String?
  type        String   // "bug" | "feature"
  title       String
  description String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
}
